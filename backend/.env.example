# 应用配置
APP_NAME=GradInsight-毕业季数据分析平台
APP_VERSION=1.0.1
APP_DESCRIPTION=专注毕业季小红书数据分析的智能分析平台
DEBUG=false

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=4000
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=gradinsight
MYSQL_CHARSET=utf8mb4

# 数据库表配置
MYSQL_POST_TABLE=posts
MYSQL_TASK_TABLE=tasks
MYSQL_COMMENT_TABLE=comments
MYSQL_USER_TABLE=users

# JWT认证配置
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 分页配置
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# 查询配置
SEARCH_OPTIONS=i

# 排序配置
POST_SORT_FIELD=time
POST_SORT_ORDER=-1
COMMENT_SORT_FIELD=time
COMMENT_SORT_ORDER=-1

# 评论配置
COMMENTS_PER_POST=20

# Consul配置
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_SERVICE_KEY=consul-crawler.rpc

# 爬虫服务配置
CRAWLER_HOST=localhost
CRAWLER_PORT=8999
GRPC_TIMEOUT=30
GRPC_MAX_RETRIES=3

# CORS配置（多个域名用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
