# =================================
# 应用基础配置
# =================================
APP_NAME=GradInsight
APP_VERSION=1.0.0
APP_DESCRIPTION=高校数据分析平台
DEBUG=false

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD_ON_CHANGE=false

# =================================
# 数据库配置
# =================================
# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=your_MYSQL_PASS
MYSQL_DATABASE=gradinsight
MYSQL_CHARSET=utf8mb4

# 数据库表名配置
MYSQL_POST_TABLE=posts
MYSQL_TASK_TABLE=tasks
MYSQL_COMMENT_TABLE=comments
MYSQL_USER_TABLE=users

# =================================
# JWT 认证配置
# =================================
# 请在生产环境中使用强密码
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =================================
# 分页和查询配置
# =================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
SEARCH_OPTIONS=i
POST_SORT_FIELD=time
POST_SORT_ORDER=-1
COMMENT_SORT_FIELD=time
COMMENT_SORT_ORDER=-1
COMMENTS_PER_POST=20

# =================================
# 微服务配置
# =================================
# Consul 服务发现配置
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
CONSUL_TIMEOUT=5

# 爬虫服务配置
CRAWLER_SERVICE_NAME=crawler-service
CRAWLER_HOST=127.0.0.1
CRAWLER_PORT=8999
GRPC_TIMEOUT=30
GRPC_MAX_RETRIES=3

# gRPC 连接配置
GRPC_KEEPALIVE_TIME_MS=30000
GRPC_KEEPALIVE_TIMEOUT_MS=10000
GRPC_RETRY_DELAY=1

# =================================
# 数据库连接配置
# =================================
# MySQL 连接重试配置
MYSQL_MAX_RETRIES=2
MYSQL_RETRY_DELAY=1.0

# =================================
# CORS 配置
# =================================
# 允许的跨域来源，用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:3000,http://0.0.0.0:8000

# =================================
# 前端配置
# =================================
FRONTEND_HOST=localhost
FRONTEND_PORT=3000

# =================================
# 开发环境配置
# =================================
# 开发模式下的额外配置
DEV_AUTO_RELOAD=true
DEV_LOG_LEVEL=DEBUG

# =================================
# 统计数据配置
# =================================
# 统计页面显示的默认值增强配置
STATS_DEFAULT_POSTS_BOOST=8500
STATS_DEFAULT_COMMENTS_BOOST=42000
STATS_DEFAULT_SCHOOLS_COUNT=285
STATS_DEFAULT_TASKS_COUNT=96
