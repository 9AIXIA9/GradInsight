# ===========================================
# GradInsight Analysis Service — 环境变量
# ===========================================
# 复制为 .env 并按需修改

# gRPC 端口（Java 后端调用）
GRPC_PORT=5001

# MySQL 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=changeit
MYSQL_DATABASE=gradinsight
MYSQL_CHARSET=utf8mb4

# Consul 服务发现
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
CONSUL_SERVICE_NAME=analysis-service

# 调试
DEBUG=false
