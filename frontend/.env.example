# =================================
# 前端环境配置文件示例
# =================================
# 复制此文件为 .env 并根据实际环境修改配置值

# =================================
# API 配置
# =================================
# API 基础URL
VITE_API_BASE_URL=http://localhost:8000

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT=30000

# =================================
# 分页配置
# =================================
# 前端分页默认配置
VITE_DEFAULT_PAGE_SIZE=20

# =================================
# 应用配置
# =================================
# 前端应用基础信息
VITE_APP_NAME=GradInsight
VITE_APP_TITLE=高校数据分析平台
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=基于小红书等社交平台的高校信息智能分析系统
VITE_APP_SUBTITLE=发现高校数据背后的洞察，助力学生择校与教育决策

# =================================
# 服务配置
# =================================
# 开发环境配置
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000

# 生产环境配置
VITE_PROD_HOST=0.0.0.0
VITE_PROD_PORT=3000
