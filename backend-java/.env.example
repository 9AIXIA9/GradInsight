# ===========================================
# GradInsight Java Backend — 环境变量
# ===========================================
# 复制为 .env 并按需修改

# 服务器端口
SERVER_PORT=8080

# MySQL 数据库
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/gradinsight?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=changeit
SPRING_JPA_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=true

# Python 分析微服务地址
ANALYSIS_SERVICE_URL=http://localhost:5000

# JWT 密钥（生产环境请生成至少32字符的随机字符串）
JWT_SECRET=change_this_secret_to_a_long_random_value_at_least_32_chars!

# Go 爬虫 gRPC 地址
CRAWLER_GRPC_HOST=localhost
CRAWLER_GRPC_PORT=8999

# Actuator
ACTUATOR_EXPOSE=*
ACTUATOR_HEALTH_DETAILS=always

# Flyway
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
